# Root .env.example — copy to apps/api/.env and apps/web/.env.local

# ─── API ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/bliss
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
CRON_SECRET=your-random-cron-secret
OPS_SECRET=your-random-ops-secret
PORT=3001
NODE_ENV=development
WEB_URL=http://localhost:3000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
VENDOR_SEARCH_ENDPOINT=
VENDOR_SEARCH_TOKEN=
VENDOR_SEARCH_PROVIDER_ID=vendor-provider-gateway-v1
VENDOR_SEARCH_TIMEOUT_MS=8000
LEGAL_AUTHORITY_ENDPOINT=
LEGAL_AUTHORITY_TOKEN=
LEGAL_AUTHORITY_PROVIDER_ID=legal-authority-gateway-v1
LEGAL_AUTHORITY_TIMEOUT_MS=8000
LEGAL_AUTHORITY_MAX_AGE_DAYS=90
EMAIL_SEND_ENDPOINT=
EMAIL_SEND_TOKEN=
EMAIL_SEND_PROVIDER_ID=email-provider-gateway-v1
EMAIL_SEND_TIMEOUT_MS=10000
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_KEY_PREFIX=bliss
MEDIA_UPLOAD_PROVIDER_ID=s3-compatible-media-v1
MEDIA_UPLOAD_MAX_BYTES=10485760
MEDIA_UPLOAD_EXPIRES_SECONDS=900
MEDIA_READ_EXPIRES_SECONDS=300
MEDIA_DELETE_TIMEOUT_MS=8000

# ─── Web ────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
NEXT_PUBLIC_API_URL=http://localhost:3001
