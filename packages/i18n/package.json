{
  "name": "@bliss/i18n",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./locales/*": "./src/locales/*",
    "./content/*": "./src/content/*"
  },
  "scripts": {
    "check:parity": "bun run scripts/check-parity.ts",
    "build:pseudo": "bun run scripts/build-pseudo-locale.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "intl-messageformat": "^10.5.14"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "typescript": "^5.4.0"
  }
}
